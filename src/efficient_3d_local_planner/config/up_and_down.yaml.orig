local_voxel_mapper:
  ros__parameters:
    use_sim_time: false                        # 实机使用系统时间；播放 bag 时由 launch 显式覆盖为 true
    frames.planning: camera_init               # 地图和规划结果使用的固定坐标系
    frames.base: base_link                     # 机器人机体坐标系
    frames.lidar: livox_lidar                  # 雷达坐标系名称
    input.cloud_topic: /cloud_registered_body  # 输入点云话题，点坐标已经位于 base_link
    input.odometry_topic: /lio_odom_hf         # 输入高频里程计话题
    map.resolution: 0.1                        # 三维栅格分辨率，单位 m
    map.size_x: 8.0                           # 滚动地图 X 方向长度，单位 m
    map.size_y: 8.0                           # 滚动地图 Y 方向长度，单位 m
    map.size_z: 6.0                           # 滚动地图 Z 方向高度，单位 m
    map.min_range: 0.30                        # 接受点云的最小距离，单位 m
    map.max_range: 8.0                         # 接受点云的最大距离，单位 m
    map.log_hit: 0.90                          # 点云命中时增加的占据 log-odds
    map.log_miss: -0.45                        # 射线穿过时增加的空闲 log-odds
    map.log_min: -2.0                          # 栅格 log-odds 下限
    map.log_max: 3.5                           # 栅格 log-odds 上限
    map.occupied_threshold: 0.40               # 判定为硬障碍的 log-odds 阈值
    map.hit_confirmation_count: 1              # 连续命中达到该次数才建立硬障碍；1 表示单帧确认
    map.raycast_enabled: true                     # 是否用点云射线穿过区域更新空闲栅格
    map.decay_enabled: true                    # 是否按最后命中时间被动衰减旧障碍
    map.decay_start: 0.75                      # 最后命中后开始时间衰减的等待时间，单位 s
    map.decay_rate: 1.20                       # 未观测栅格每秒降低的 log-odds
    map.decay_front_only: false                 # 仅对机体前方旧障碍做时间衰减，后方地图保留
    map.decay_front_fov_deg: 180.0    # FOV        # 前向衰减扇区总角度，120 表示左右各 60 度
    map.ray_step_factor: 0.90                  # 射线采样步长相对栅格分辨率的比例
    robot.cylinder_radius: 0.2                 # 单个机体碰撞圆柱的 XY 半径，单位 m
    robot.soft_clearance: 0.4        #          # 物理碰撞层外的可穿越软代价带，参考 SCAN preferred_clearance
    map.obstacles_inflation_z_down: 0.10   #    # 障碍物向下膨胀距离，单位 m
    map.obstacles_inflation_z_up: 0.00         # 障碍物向上膨胀距离，单位 m
    extrinsic.base_to_lidar_x: 0.15            # 雷达射线起点相对机体的 X 平移，单位 m
    extrinsic.base_to_lidar_y: 0.0             # 雷达相对机体的 Y 平移，单位 m
    extrinsic.base_to_lidar_z: 0.21            # 雷达射线起点相对机体的 Z 平移，单位 m
    extrinsic.base_to_lidar_roll: 0.0          # 雷达相对机体的横滚角，单位 rad
    extrinsic.base_to_lidar_pitch: 0.0         # 雷达相对机体的俯仰角，单位 rad
    extrinsic.base_to_lidar_yaw: 0.0           # 雷达相对机体的偏航角，单位 rad
    filter.body_exclusion_enabled: true        # 是否过滤落在机器人机身内的点云
    filter.body_half_length: 0.55              # 机身过滤框 X 方向半长度，单位 m
    filter.body_half_width: 0.10               # 与 SCAN 对齐：机身过滤框 Y 方向半宽度，单位 m
    filter.body_half_height: 0.35              # 与 SCAN 对齐：机身过滤框上下半高度，单位 m
    sync.tolerance: 0.035                      # 点云和里程计允许的最大时间差，单位 s
    sync.queue_size: 200                       # 内部里程计历史；覆盖实测最大约 0.67s 的 GLIO 点云延迟
    sync.cloud_qos_depth: 20                   # 点云 DDS 接收队列深度，吸收 GLIO 突发发布
    sync.odometry_qos_depth: 100               # 200Hz 里程计 DDS 接收队列深度，覆盖约 0.5s
    sync.max_wait: 0.20                        # 等待可匹配里程计的最大单调时钟时间，单位 s

corridor_astar_planner:
  ros__parameters:
    use_sim_time: false                        # 实机使用系统时间；播放 bag 时由 launch 显式覆盖为 true
    frames.planning: camera_init               # A* 搜索使用的固定坐标系
    input.path_topic: /recorded_waypoint_route/active_segment_ground # 仅规划严格到点切换的录制路线当前段
    planner.path_height: 0.40                  # 全局路径整体向上抬升高度，单位 m
    planner.project_start_z: true              # 起点 Z 是否投影到抬升后的全局路径
    planner.start_z_max_correction: 0.60       # 起点 Z 允许的最大投影修正量，单位 m
    planner.reject_wrong_path_level: true      # 路径高度与机器人相差过大时保留旧路径，不向错误楼层搜索
    planner.horizon: 2.8                       # 局部规划沿全局路径的前视距离，单位 m
    planner.guide_spacing: 0.15                # 路径引导点的重采样间距，单位 m
    planner.replacement_grace_period: 0.25     # 旧路径失效后等待新路径原子替换的最长时间，期间不发布瞬时空路径
    planner.corridor_xy: 1.50                  # 全局路径两侧允许搜索的水平范围，单位 m
    planner.corridor_z: 0.40                   # 参考路径上下允许搜索的高度范围，单位 m
    planner.soft_weight: 12.0        #          # 放宽阶段软安全层的代价权重
    planner.path_weight: 0.1                  # 关闭偏离全局参考路径的代价，仅保留搜索管道约束
    planner.vertical_weight: 0.60              # 上下高度变化的代价权重
    planner.turn_weight: 0.08                  # 航向变化的代价权重
    planner.rotation_cost: 0.12                # 急弯处原地旋转一个 45 度航向状态的代价
    planner.max_simplified_segment: 0.80        # 简化后单段最大长度，避免急弯被压成跨角长直线
    planner.goal_tolerance: 0.30               # A* 进入该范围后尝试无碰撞直连精确局部目标，单位 m
    planner.start_snap_radius: 0.50             # 起点占据时参考 SCAN 向后/邻域寻找自由起点的最大距离
    planner.goal_snap_radius: 0.60             # 目标被占据时搜索附近可用目标的半径，单位 m
    planner.strict_max_expansions: 8000        # 严格阶段允许扩展的最大节点数
    planner.max_expansions: 120000             # 放宽阶段允许扩展的最大节点数
    robot.cylinder_offset: 0.18                # 前后两个圆柱中心相对机体中心的偏移，单位 m
    optimization.enabled: true                 # 启用B样条优化，成功结果作为实际控制轨迹
    optimization.control_point_spacing: 0.20   # B 样条控制点初始化间距，单位 m
    optimization.sample_spacing: 0.05          # 代价和最终碰撞复查的曲线采样间距，单位 m
    optimization.max_iterations: 80            # 最大梯度下降迭代次数
    optimization.max_clearance_repair_iterations: 25 # 联合优化后只针对安全间距的修复迭代
    optimization.max_step: 0.04                # 单次迭代控制点最大移动量，单位 m
    optimization.lambda_smooth: 1.0            # 二阶差分平滑代价权重
    optimization.lambda_collision: 400.0       # 最近硬障碍边界有符号距离的斥力权重
    optimization.lambda_reference: 3.0         # 超出参考路径死区后的回拉权重
    optimization.lambda_goal: 4.0              # 可移动局部目标点回到原目标的锚定权重
    optimization.clearance_distance: 0.30      # 硬碰撞层外期望保留的额外距离，单位 m
    optimization.minimum_acceptable_clearance: 0.25 # 忽略不可移动起步段后，轨迹至少达到的间距
    optimization.start_clearance_ignore_distance: 0.20 # 起点固定，前 0.20m 不参与成功间距门限
    optimization.reference_deadband: 0.10      # 偏离原局部路径的零代价半宽，单位 m
    optimization.max_deviation: 0.75           # 控制点相对原局部路径的最大三维偏移，单位 m
    optimization.max_z_deviation: 0.75         # 正常优化允许的高度偏差；窄路/楼梯重试会单独收紧
    optimization.goal_max_deviation: 0.55      # 拐角目标允许横向避障的最大移动量，单位 m
    optimization.allow_goal_adjustment: true   # 允许分段终点离开障碍，仍由目标锚定代价约束
    optimization.narrow.enabled: true          # 正常B样条失败后，从未简化A*路径启动窄通道重试
    optimization.narrow.control_point_spacing: 0.10 # 密集控制点减少狭窄拐角切弯
    optimization.narrow.sample_spacing: 0.03   # 更密碰撞采样，避免曲线从体素之间漏检
    optimization.narrow.max_iterations: 100    # 窄通道联合优化迭代上限
    optimization.narrow.max_clearance_repair_iterations: 40 # 窄通道净空修复迭代上限
    optimization.narrow.lambda_smooth: 0.25    # 降低平滑权重，优先贴合可通行A*路径
    optimization.narrow.lambda_collision: 600.0 # 提高硬障碍边界斥力
    optimization.narrow.lambda_reference: 8.0  # 防止窄弯处偏离A*路径后切角
    optimization.narrow.minimum_acceptable_clearance: 0.10 # 硬碰撞层外至少保留一个体素净空
    optimization.narrow.reference_deadband: 0.04 # 窄通道允许的无代价参考偏差
    optimization.narrow.max_deviation: 0.35    # 限制窄通道控制点横向漂移
    optimization.narrow.max_z_deviation: 0.05  # 上下楼时紧贴A*高度，避免平滑穿入台阶
    optimization.narrow.goal_max_deviation: 0.30 # 窄通道终点允许的小范围避障调整

local_path_follower:
  ros__parameters:
    use_sim_time: false                        # 实机使用系统时间；播放 bag 时由 launch 显式覆盖为 true
    controller.enabled: true                   # 是否启用局部路径跟踪控制器
    controller.control_rate: 50.0              # 速度控制循环频率，单位 Hz
    controller.nominal_speed: 0.65             # 正常路径跟踪速度，单位 m/s
    controller.max_vx: 0.80                    # 机体 X 方向最大速度，单位 m/s
    controller.max_vy: 0.80                    # 机体 Y 方向最大速度，单位 m/s
    controller.max_vyaw: 0.80                  # 最大偏航角速度，单位 rad/s
    controller.position_gain: 0.80             # 横向位置误差的速度反馈增益
    controller.yaw_gain: 0.80                  # 偏航角误差的角速度反馈增益
    controller.lookahead_base: 0.15            # 与 SCAN 一致的基础前视距离，单位 m
    controller.lookahead_speed_gain: 0.40      # 与 SCAN 一致，按目标跟踪速度增加前视
    controller.lookahead_min: 0.15             # 与 SCAN 一致的最小前视距离，单位 m
    controller.lookahead_max: 0.35             # 与 SCAN 一致的最大前视距离，单位 m
    controller.tangent_window: 0.30            # 计算平滑路径切向的窗口长度，单位 m
    controller.finish_distance: 0.15           # 距局部路径终点小于该值时停车，单位 m
    controller.braking_deceleration: 0.60      # 接近终点时采用的减速度，单位 m/s^2
    controller.translation_yaw_limit: 0.698132 # 偏航误差达到 40 度时停止平移，只原地对准
    controller.yaw_deadband: 0.04              # 小于该偏航误差时不输出角速度，单位 rad
    controller.max_linear_acceleration: 0.60   # 最大平面线加速度，单位 m/s^2
    controller.max_yaw_acceleration: 0.60      # 最大偏航角加速度，单位 rad/s^2
    controller.odometry_timeout: 10.00          # 里程计超过该时间未更新则停车，单位 s
    controller.path_timeout: 10.00              # 局部路径超过该时间未更新则停车，单位 s
