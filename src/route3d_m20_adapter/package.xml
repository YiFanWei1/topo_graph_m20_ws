<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>route3d_m20_adapter</name>
  <version>0.1.0</version>
  <description>Fail-closed ROS velocity arbiter for Route3D on the M20 robot.</description>
  <maintainer email="wei@example.com">wei</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>drdds</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nlohmann_json</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <exec_depend>efficient_3d_local_planner</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>obstacle_occlusion_extension</exec_depend>
  <exec_depend>route3d_pid_controller</exec_depend>
  <depend>tf2_ros</depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
