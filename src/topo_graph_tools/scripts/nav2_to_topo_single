#!/usr/bin/env python3
"""Convert Route3D targets or an arbitrary topology graph for visualization.

The input graph supplies timestamped poses and quaternions. The target file
supplies the final interval/corner selection and ground-referenced z values.
The converter writes the requested topoSingle schema and, optionally, a reduced
nav2_route3d graph.  Topology input preserves stable vertex/edge IDs and arbitrary
forest endpoint relationships.
"""

import argparse
import json
import math
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

from route3d_topology_core import apply_topology_schema


Point3 = Tuple[float, float, float]


def finite(value: Any) -> float:
    result = float(value)
    if not math.isfinite(result):
        raise ValueError("non-finite numeric value")
    return result


def quaternion_to_rpy(qx: float, qy: float, qz: float, qw: float) -> List[float]:
    """Convert a quaternion in qx,qy,qz,qw order to roll,pitch,yaw."""

    sin_roll = 2.0 * (qw * qx + qy * qz)
    cos_roll = 1.0 - 2.0 * (qx * qx + qy * qy)
    roll = math.atan2(sin_roll, cos_roll)

    sin_pitch = 2.0 * (qw * qy - qz * qx)
    pitch = math.asin(max(-1.0, min(1.0, sin_pitch)))

    sin_yaw = 2.0 * (qw * qz + qx * qy)
    cos_yaw = 1.0 - 2.0 * (qy * qy + qz * qz)
    yaw = math.atan2(sin_yaw, cos_yaw)
    return [roll, pitch, yaw]


def rpy_to_quaternion(roll: float, pitch: float, yaw: float) -> List[float]:
    cr, sr = math.cos(roll * 0.5), math.sin(roll * 0.5)
    cp, sp = math.cos(pitch * 0.5), math.sin(pitch * 0.5)
    cy, sy = math.cos(yaw * 0.5), math.sin(yaw * 0.5)
    return [
        sr * cp * cy - cr * sp * sy,
        cr * sp * cy + sr * cp * sy,
        cr * cp * sy - sr * sp * cy,
        cr * cp * cy + sr * sp * sy,
    ]


def distance(first: Point3, second: Point3) -> float:
    return math.sqrt(sum((left - right) ** 2 for left, right in zip(first, second)))


def parse_targets(path: Path) -> Tuple[str, List[Dict[str, Any]]]:
    frame_id = "camera_init"
    targets: List[Dict[str, Any]] = []
    for line_number, raw_line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        line = raw_line.strip()
        if not line:
            continue
        if line.startswith("#"):
            if line.lower().startswith("# frame_id:"):
                frame_id = line.split(":", 1)[1].strip()
            continue
        data, _, comment = line.partition("#")
        fields = data.split()
        if len(fields) != 5:
            raise ValueError(
                f"{path}:{line_number}: expected 'id x y z_ground NORMAL|CORNER'")
        target_id = int(fields[0])
        point = [finite(value) for value in fields[1:4]]
        target_type = fields[4].upper()
        if target_type not in ("NORMAL", "CORNER"):
            raise ValueError(f"{path}:{line_number}: unsupported target type {target_type}")
        angle: Optional[float] = None
        for key in ("yaw_change_deg", "turn_deg"):
            marker = key + "="
            if marker in comment:
                angle = finite(comment.split(marker, 1)[1].split()[0])
                break
        targets.append({
            "id": target_id,
            "ground": point,
            "type": target_type,
            "turn_deg": angle,
        })
    if len(targets) < 2:
        raise ValueError("target file must contain at least two targets")
    ids = [item["id"] for item in targets]
    if len(set(ids)) != len(ids):
        raise ValueError("target IDs must be unique")
    return frame_id, targets


def load_graph_poses(path: Path) -> Tuple[str, List[Dict[str, Any]]]:
    payload = json.loads(path.read_text(encoding="utf-8"))
    poses: List[Dict[str, Any]] = []
    for node in payload.get("nodes", []):
        pose = node.get("pose", [])
        if len(pose) < 8:
            continue
        values = [finite(value) for value in pose[:8]]
        poses.append({
            "node_id": int(node["id"]),
            "stamp": values[0],
            "body": (values[1], values[2], values[3]),
            "quaternion": values[4:8],
        })
    if len(poses) < 2:
        raise ValueError("graph must contain at least two timestamped nodes")
    poses.sort(key=lambda item: item["stamp"])
    return str(payload.get("frame_id", "map")), poses


def nearest_pose(target: Point3, poses: List[Dict[str, Any]], body_height: float) -> Dict[str, Any]:
    body_target = (target[0], target[1], target[2] + body_height)
    return min(poses, key=lambda item: distance(body_target, item["body"]))


def build_topo(
    frame_id: str,
    targets: List[Dict[str, Any]],
    poses: List[Dict[str, Any]],
    body_height: float,
    topo_type: int,
    pcd: str,
    acc: float,
    turnable: bool,
    direction: int,
) -> Dict[str, Any]:
    vertices: Dict[str, Any] = {}
    for target in targets:
        target_pose = nearest_pose(target["ground"], poses, body_height)
        rpy = quaternion_to_rpy(*target_pose["quaternion"])
        metadata: Dict[str, Any] = {
            "type": 0,
            "typeId": 0,
            "isCorner": target["type"] == "CORNER",
            "source": "route3d_targets",
            "sourceNodeId": target_pose["node_id"],
        }
        if target["turn_deg"] is not None:
            metadata["turnDeg"] = target["turn_deg"]
        vertices[str(target["id"])] = {
            "pos": target["ground"],
            "rpy": rpy,
            "meta": metadata,
            "pcd": pcd,
            "acc": acc,
            "turnable": turnable,
        }

    edges: Dict[str, Any] = {}
    for edge_id, (first, second) in enumerate(zip(targets, targets[1:]), 1):
        first_id = first["id"]
        second_id = second["id"]
        if direction == 2:
            endpoints = [second_id, first_id]
        else:
            endpoints = [first_id, second_id]
        edges[str(edge_id)] = {
            "v": endpoints,
            "weight": distance(first["ground"], second["ground"]),
            "meta": {
                "dir": direction,
                "source": "route3d_targets",
            },
        }

    return apply_topology_schema({
        "version": 0,
        "type": topo_type,
        "frame_id": frame_id,
        "vertices": vertices,
        "edges": edges,
    })


def build_reduced_nav2(
    frame_id: str,
    targets: List[Dict[str, Any]],
    poses: List[Dict[str, Any]],
    body_height: float,
    direction: int,
) -> Dict[str, Any]:
    nodes = []
    for target in targets:
        source = nearest_pose(target["ground"], poses, body_height)
        qx, qy, qz, qw = source["quaternion"]
        nodes.append({
            "id": target["id"],
            "pose": [source["stamp"], source["body"][0], source["body"][1], source["body"][2],
                     qx, qy, qz, qw],
            "metadata": {
                "source": "route3d_target",
                "target_type": target["type"],
                "is_corner": target["type"] == "CORNER",
                "source_node_id": source["node_id"],
                **({"turn_deg": target["turn_deg"]} if target["turn_deg"] is not None else {}),
            },
            "real_neighbors": [],
            "fake_neighbors": [],
        })

    edges = []
    for edge_id, (first, second) in enumerate(zip(targets, targets[1:]), 1):
        start_id, end_id = first["id"], second["id"]
        if direction == 2:
            start_id, end_id = end_id, start_id
        edges.append({
            "id": edge_id,
            "start_id": start_id,
            "end_id": end_id,
            "cost": distance(first["ground"], second["ground"]),
            "bidirectional": direction == 0,
            "metadata": {"edge_source": "route3d_targets", "edge_type": "selected_route"},
            "operations": [],
        })

    neighbors = {target["id"]: set() for target in targets}
    for edge in edges:
        neighbors[edge["start_id"]].add(edge["end_id"])
        if edge["bidirectional"]:
            neighbors[edge["end_id"]].add(edge["start_id"])
    for node in nodes:
        node["real_neighbors"] = sorted(neighbors[node["id"]])

    return {
        "format": "nav2_route3d",
        "version": 1,
        "frame_id": frame_id,
        "metadata": {"source": "route3d_targets", "selected_target_count": len(targets)},
        "nodes": nodes,
        "edges": edges,
    }


def build_nav2_from_topology(path: Path, body_height: float) -> Dict[str, Any]:
    """Convert arbitrary undirected topoGraph edges without imposing ID order."""
    payload = json.loads(path.read_text(encoding="utf-8"))
    frame_id = str(payload.get("frame_id", "camera_init")).strip()
    vertices = payload.get("vertices")
    graph_edges = payload.get("edges")
    if not frame_id or not isinstance(vertices, dict) or not isinstance(graph_edges, dict):
        raise ValueError("topology must contain frame_id, vertices and edges")

    nodes = []
    known_ids = set()
    for raw_id, vertex in sorted(vertices.items(), key=lambda item: int(item[0])):
        vertex_id = int(raw_id)
        if vertex_id < 1 or str(vertex_id) != raw_id or vertex_id in known_ids:
            raise ValueError(f"invalid topology vertex id {raw_id!r}")
        known_ids.add(vertex_id)
        position = vertex.get("pos", [])
        rpy = vertex.get("rpy", [])
        if len(position) != 3 or len(rpy) != 3:
            raise ValueError(f"topology vertex {vertex_id} needs pos and rpy arrays")
        ground = [finite(value) for value in position]
        orientation = rpy_to_quaternion(*(finite(value) for value in rpy))
        metadata = vertex.get("meta", {})
        if not isinstance(metadata, dict):
            raise ValueError(f"topology vertex {vertex_id}.meta must be an object")
        nodes.append({
            "id": vertex_id,
            "pose": [
                finite(metadata.get("sourceStamp", 0.0)),
                ground[0], ground[1], ground[2] + body_height,
                *orientation,
            ],
            "metadata": {
                "source": "topology_graph",
                "is_corner": bool(metadata.get("isCorner", False)),
                "is_slope": bool(metadata.get("isSlope", False)),
                "is_junction": bool(metadata.get("isJunction", False)),
                "component": int(metadata.get("component", 0)),
            },
            "real_neighbors": [],
            "fake_neighbors": [],
        })

    edges = []
    seen_pairs = set()
    for raw_id, edge in sorted(graph_edges.items(), key=lambda item: int(item[0])):
        edge_id = int(raw_id)
        endpoints = edge.get("v", [])
        metadata = edge.get("meta", {})
        if edge_id < 1 or str(edge_id) != raw_id or len(endpoints) != 2:
            raise ValueError(f"invalid topology edge {raw_id!r}")
        first, second = int(endpoints[0]), int(endpoints[1])
        if first == second or first not in known_ids or second not in known_ids:
            raise ValueError(f"topology edge {edge_id} has invalid endpoints")
        pair = tuple(sorted((first, second)))
        if pair in seen_pairs:
            raise ValueError(f"duplicate topology edge {pair}")
        seen_pairs.add(pair)
        direction = int(metadata.get("dir", 0)) if isinstance(metadata, dict) else 0
        if direction != 0:
            raise ValueError("phase-one topology visualization requires undirected edges")
        edges.append({
            "id": edge_id,
            "start_id": first,
            "end_id": second,
            "cost": finite(edge.get("weight", 0.0)),
            "bidirectional": True,
            "metadata": {
                "edge_source": "topology_graph",
                "edge_type": "discovered_topology",
                "topology_source": metadata.get("source", "discovery")
                if isinstance(metadata, dict) else "discovery",
            },
            "operations": [],
        })

    neighbors = {vertex_id: set() for vertex_id in known_ids}
    for edge in edges:
        neighbors[edge["start_id"]].add(edge["end_id"])
        neighbors[edge["end_id"]].add(edge["start_id"])
    for node in nodes:
        node["real_neighbors"] = sorted(neighbors[node["id"]])
    return {
        "format": "nav2_route3d",
        "version": 1,
        "frame_id": frame_id,
        "metadata": {
            "source": "topology_graph",
            "topology_mode": payload.get("topology_mode", "graph"),
        },
        "nodes": nodes,
        "edges": edges,
    }


def write_json(path: Path, payload: Dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(payload, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--graph", required=True, type=Path)
    inputs = parser.add_mutually_exclusive_group(required=True)
    inputs.add_argument("--targets", type=Path)
    inputs.add_argument("--topology", type=Path,
                        help="topoGraph JSON whose arbitrary edges must be preserved")
    parser.add_argument(
        "--output", type=Path,
        help="write topoSingle JSON; optional when --output-nav2 is supplied")
    parser.add_argument("--output-nav2", type=Path)
    parser.add_argument("--body-height", type=float, default=0.57)
    parser.add_argument("--topo-type", type=int, default=0)
    parser.add_argument("--pcd", default="")
    parser.add_argument("--acc", type=float, default=0.5)
    parser.add_argument("--turnable", choices=("true", "false"), default="true")
    parser.add_argument("--direction", type=int, choices=(0, 1, 2), default=0)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if args.output is None and args.output_nav2 is None:
        raise ValueError("at least one of --output and --output-nav2 is required")
    if not math.isfinite(args.body_height) or args.body_height < 0.0:
        raise ValueError("body-height must be finite and non-negative")
    if not math.isfinite(args.acc) or args.acc < 0.0:
        raise ValueError("acc must be finite and non-negative")

    graph_frame, poses = load_graph_poses(args.graph)
    if args.topology:
        if args.output is not None:
            raise ValueError("--output topoSingle is only supported with --targets")
        if args.output_nav2 is None:
            raise ValueError("--topology requires --output-nav2")
        reduced = build_nav2_from_topology(args.topology, args.body_height)
        if reduced["frame_id"] != graph_frame:
            print(
                f"warning: topology frame {reduced['frame_id']} differs "
                f"from graph frame {graph_frame}")
        write_json(args.output_nav2, reduced)
        print(
            f"converted topology graph: {len(reduced['nodes'])} vertices, "
            f"{len(reduced['edges'])} edges nav2={args.output_nav2}")
        return 0

    target_frame, targets = parse_targets(args.targets)
    if target_frame != graph_frame:
        print(f"warning: target frame {target_frame} differs from graph frame {graph_frame}")

    topo = build_topo(
        target_frame, targets, poses, args.body_height, args.topo_type, args.pcd,
        args.acc, args.turnable == "true", args.direction)
    if args.output:
        write_json(args.output, topo)

    if args.output_nav2:
        reduced = build_reduced_nav2(
            target_frame, targets, poses, args.body_height, args.direction)
        write_json(args.output_nav2, reduced)

    corners = sum(target["type"] == "CORNER" for target in targets)
    print(
        f"converted {len(targets)} targets ({corners} corners), "
        f"{len(targets) - 1} edges"
        + (f" topo={args.output}" if args.output else "")
        + (f" nav2={args.output_nav2}" if args.output_nav2 else ""))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, KeyError, json.JSONDecodeError) as error:
        print(f"nav2_to_topo_single: {error}")
        raise SystemExit(1)
