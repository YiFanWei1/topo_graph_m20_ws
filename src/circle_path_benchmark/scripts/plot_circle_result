#!/usr/bin/env python3
"""Plot fixed circle, active odometry track and signed radial error."""

import argparse
import csv
import json
from pathlib import Path

import matplotlib.pyplot as plt
import yaml


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--session", required=True)
    parser.add_argument("--output", default="")
    args = parser.parse_args()

    session = Path(args.session).expanduser().resolve()
    reference_file = session / "reference_circle.yaml"
    trajectory_file = session / "trajectory.csv"
    metrics_file = session / "metrics.json"
    for required in (reference_file, trajectory_file, metrics_file):
        if not required.is_file():
            raise SystemExit(f"missing benchmark result: {required}")

    with reference_file.open(encoding="utf-8") as stream:
        reference = yaml.safe_load(stream)
    with metrics_file.open(encoding="utf-8") as stream:
        metrics = json.load(stream)
    rows = []
    with trajectory_file.open(encoding="utf-8", newline="") as stream:
        for row in csv.DictReader(stream):
            if row["active"] == "1":
                rows.append(row)
    if len(rows) < 2:
        raise SystemExit("trajectory.csv has fewer than two active samples")

    reference_points = reference["points"]
    ref_x = [float(point[0]) for point in reference_points]
    ref_y = [float(point[1]) for point in reference_points]
    actual_x = [float(row["x"]) for row in rows]
    actual_y = [float(row["y"]) for row in rows]
    progress = [float(row["progress_rad"]) for row in rows]
    radial_error = [float(row["radial_error_m"]) for row in rows]

    figure, axes = plt.subplots(1, 2, figsize=(13, 6))
    axes[0].plot(ref_x, ref_y, color="green", linewidth=2.5, label="fixed reference")
    axes[0].plot(actual_x, actual_y, color="magenta", linewidth=1.8, label="odometry")
    axes[0].scatter([actual_x[0]], [actual_y[0]], color="blue", s=45, label="start")
    axes[0].set_aspect("equal")
    axes[0].grid(True)
    axes[0].set_xlabel("x [m]")
    axes[0].set_ylabel("y [m]")
    axes[0].set_title("Reference circle vs actual trajectory")
    axes[0].legend()

    axes[1].plot(progress, radial_error, color="tab:red", linewidth=1.5)
    axes[1].axhline(0.0, color="black", linewidth=1)
    axes[1].fill_between(progress, radial_error, 0.0, where=[
        value < 0.0 for value in radial_error], color="orange", alpha=0.3,
        label="inside cut")
    axes[1].grid(True)
    axes[1].set_xlabel("directed progress [rad]")
    axes[1].set_ylabel("signed radial error [m]")
    axes[1].set_title(
        f"RMS={metrics['rms_radial_error_m']:.3f}m, "
        f"max inward={metrics['maximum_inward_cut_m']:.3f}m")
    axes[1].legend()

    figure.tight_layout()
    output = Path(args.output).expanduser().resolve() if args.output else \
        session / "comparison.png"
    output.parent.mkdir(parents=True, exist_ok=True)
    figure.savefig(output, dpi=180)
    print(output)


if __name__ == "__main__":
    main()
