<?xml version="1.0"?>
<package format="3">
  <name>route3d_online_skeleton</name>
  <version>0.1.0</version>
  <description>Incrementally build and visualize a Route3D topology from synchronized poses.</description>
  <maintainer email="wei@example.com">wei</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>route_slope_annotator</exec_depend>
  <exec_depend>route3d_topology_core</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
