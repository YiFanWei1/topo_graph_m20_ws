    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Current Body Cloud1
        - /TF1
        - /Axes1
      Splitter Ratio: 0.5
    Tree Height: 554
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
