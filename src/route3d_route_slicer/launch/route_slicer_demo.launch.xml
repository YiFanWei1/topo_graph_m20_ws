<?xml version="1.0"?>
<launch>
  <arg name="graph_file"
       default="$(find-pkg-share route3d_dijkstra_planner)/config/complex_topology_v2.json"/>
  <arg name="config_file"
       default="$(find-pkg-share route3d_route_slicer)/config/route_slicer.yaml"/>
  <arg name="rviz_config"
       default="$(find-pkg-share route3d_route_slicer)/rviz/route_slicer.rviz"/>
  <arg name="start_planner" default="true"/>
  <arg name="launch_rviz" default="true"/>
  <arg name="auto_demo" default="false"/>
  <arg name="demo_interval" default="4.0"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="start_snap_radius_m" default="1.0"/>
  <arg name="odometry_body_height_m" default="0.57"/>

  <node pkg="route3d_dijkstra_planner" exec="dijkstra_planner_node"
        name="route3d_dijkstra_planner" output="screen" if="$(var start_planner)">
    <param name="graph_file" value="$(var graph_file)"/>
    <param name="strict_schema_v2" value="true"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="request.start_snap_radius_m" value="$(var start_snap_radius_m)"/>
    <param name="request.odometry_body_height_m" value="$(var odometry_body_height_m)"/>
  </node>

  <node pkg="route3d_dijkstra_planner" exec="dijkstra_demo_requests"
        name="route3d_dijkstra_demo_requests" output="screen" if="$(var auto_demo)">
    <param name="interval_seconds" value="$(var demo_interval)"/>
    <param name="repeat" value="true"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node pkg="route3d_route_slicer" exec="route_slicer_node"
        name="route3d_route_slicer" output="screen">
    <param from="$(var config_file)"/>
    <param name="graph_file" value="$(var graph_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node pkg="rviz2" exec="rviz2" name="route3d_route_slicer_rviz"
        args="-d $(var rviz_config)" output="screen" if="$(var launch_rviz)">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
