<?xml version="1.0"?>
<package format="3">
  <name>path_tracking_benchmark</name>
  <version>0.1.0</version>
  <description>Fixed-path closed-loop tracking benchmark for the efficient 3-D local path follower.</description>
  <maintainer email="wei@example.com">wei</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>efficient_3d_local_planner</exec_depend>
  <exec_depend>robot_control_adapter</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
