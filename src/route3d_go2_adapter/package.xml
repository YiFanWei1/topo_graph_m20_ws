<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>route3d_go2_adapter</name>
  <version>0.1.0</version>
  <description>Go2 motion adapter with automatic Route3D gait-transition execution.</description>
  <maintainer email="wei@example.com">wei</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>nlohmann_json</depend>
  <depend>rclcpp</depend>
  <depend>route3d_pid_controller</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>efficient_3d_local_planner</exec_depend>
  <exec_depend>obstacle_occlusion_extension</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <!-- unitree_sdk2 is a non-ROS system dependency found by CMake. -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
