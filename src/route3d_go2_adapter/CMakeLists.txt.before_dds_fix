cmake_minimum_required(VERSION 3.16)
project(route3d_go2_adapter)

if(NOT CMAKE_BUILD_TYPE)
  set(CMAKE_BUILD_TYPE Release CACHE STRING "Build type" FORCE)
endif()

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
  add_compile_options(-Wall -Wextra -Wpedantic -Wconversion -Wshadow)
endif()

find_package(ament_cmake REQUIRED)
find_package(geometry_msgs REQUIRED)
find_package(nlohmann_json REQUIRED)
find_package(rclcpp REQUIRED)
find_package(route3d_pid_controller REQUIRED)
find_package(std_msgs REQUIRED)
find_package(std_srvs REQUIRED)
find_package(unitree_sdk2 REQUIRED)

add_executable(go2_route_adapter_node src/go2_route_adapter_node.cpp)
ament_target_dependencies(go2_route_adapter_node
  geometry_msgs
  rclcpp
  route3d_pid_controller
  std_msgs
  std_srvs)
target_link_libraries(go2_route_adapter_node
  nlohmann_json::nlohmann_json
  unitree_sdk2)

get_target_property(UNITREE_SDK2_LIBRARY unitree_sdk2 IMPORTED_LOCATION)
get_filename_component(UNITREE_SDK2_LIBRARY_DIR "${UNITREE_SDK2_LIBRARY}" DIRECTORY)
set_target_properties(go2_route_adapter_node PROPERTIES
  BUILD_RPATH "${UNITREE_SDK2_LIBRARY_DIR}"
  INSTALL_RPATH "${UNITREE_SDK2_LIBRARY_DIR}")
target_link_options(go2_route_adapter_node PRIVATE "LINKER:--disable-new-dtags")

install(TARGETS go2_route_adapter_node DESTINATION lib/${PROJECT_NAME})
install(DIRECTORY config launch DESTINATION share/${PROJECT_NAME})

ament_package()
