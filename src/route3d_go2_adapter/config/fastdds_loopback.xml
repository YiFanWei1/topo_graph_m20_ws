<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!--
    Keep the adapter's ROS 2 Fast DDS traffic on loopback so it can communicate
    with the host's local-only CycloneDDS graph.  Unitree SDK traffic is
    independent and still uses the network_interface parameter (for example
    enp2s0).
  -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>route3d_loopback_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="route3d_loopback" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>route3d_loopback_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
